<Window x:Class="OpenMyDear.Wpf.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenMyDear"
        Width="720"
        MinWidth="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Localizer[Edit]}"
                   Style="{StaticResource SectionHeaderTextStyle}"
                   Margin="0,0,0,16" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Localizer[Label]}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="0,0,12,0"
                     Text="{Binding SelectedItem.Label, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding ItemTypes}"
                      SelectedItem="{Binding SelectedItem.Type, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Localizer[Path]}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="0,0,8,0"
                     Text="{Binding SelectedItem.Path, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    Content="{Binding Localizer[PickAppShort]}" Command="{Binding PickSelectedItemAsAppCommand}" />
            <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    Content="{Binding Localizer[PickFile]}" Command="{Binding PickSelectedItemAsFileCommand}" />
            <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}"
                    Content="{Binding Localizer[PickFolder]}" Command="{Binding PickSelectedItemAsFolderCommand}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Localizer[OpenWithPath]}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="0,0,8,0"
                     Text="{Binding SelectedItem.OpenWith, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    Content="{Binding Localizer[PickApp]}" Command="{Binding PickOpenWithCommand}" />
            <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}"
                    Content="{Binding Localizer[Clear]}" Command="{Binding ClearOpenWithCommand}" />
        </Grid>

        <Button Grid.Row="4"
                Style="{StaticResource PrimaryButtonStyle}"
                Width="100"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Content="{Binding Localizer[Done]}" />
    </Grid>
</Window>
